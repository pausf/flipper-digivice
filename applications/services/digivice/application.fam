App(
    appid="digivice_srv",
    name="DigiviceSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="digivice_srv",
    cdefines=["SRV_DIGIVICE"],
    requires=[
        "dolphin",
        "notification",
        "storage",
    ],
    # Explicit list: fbt globs app folders recursively, and test/ must stay out of the firmware.
    sources=[
        "digivice_srv.c",
        "digivice_rules.c",
        "digivice_expedition.c",
        "digivice_notify.c",
        "digivice_draw.c",
        "digivice_i18n.c",
    ],
    stack_size=2 * 1024,
    order=110,
)
